import { Palette } from "std-widgets.slint";

export global WindowControls {
    callback minimize();
    callback maximize();
    callback close();
    callback drag();
    callback double-click();

    in-out property <bool> maximized: false;

    // 暴露尺寸配置给 Rust 消息判定
    // Expose size config for Rust hit-test calculation
    in-out property <bool> show-minimize: true;
    in-out property <bool> show-maximize: true;
    in-out property <bool> show-close: true;
    in-out property <length> titlebar-height: 32px;
    in-out property <length> close-width: 46px;
    in-out property <length> maximize-width: 46px;
    in-out property <length> minimize-width: 46px;

    // 由 Win32 非客户区消息驱动的三个按钮悬停状态
    in-out property <bool> min-hover: false;
    in-out property <bool> max-hover: false;
    in-out property <bool> close-hover: false;
}

export component Titlebar inherits Rectangle {
    in property <string> title: "Application";
    in property <image> icon;

    // 深色模式纯白 (#ffffff)，浅色模式淡灰 (#cccccc)
    private property <color> foreground-color: Palette.color-scheme == ColorScheme.dark ? #ffffff : #cccccc;
    private property <color> btn-hover-bg: Palette.color-scheme == ColorScheme.dark ? #ffffff1a : #80808030;

    height: WindowControls.titlebar-height;
    background: transparent;

    HorizontalLayout {
        padding: 0px;
        spacing: 0px;

        drag-area := TouchArea {
            horizontal-stretch: 1;
            moved => {
                if (self.pressed) {
                    WindowControls.drag();
                }
            }

            double-clicked => {
                WindowControls.double-click();
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                spacing: 8px;
                alignment: start;

                if root.icon.width > 0 && root.icon.height > 0: Image {
                    source: root.icon;
                    width: 16px;
                    height: 16px;
                    vertical-alignment: center;
                }

                Text {
                    text: root.title;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // 最小化按钮
        // Minimize button
        if WindowControls.show-minimize: minimize-btn := Rectangle {
            width: WindowControls.minimize-width;
            background: (minimize-touch.has-hover || WindowControls.min-hover) ? root.btn-hover-bg : transparent;
            animate background { duration: 100ms; }

            minimize-touch := TouchArea {
                clicked => { WindowControls.minimize(); }
            }

            Rectangle {
                width: 10px;
                // 1px 逻辑像素：100% = 1px，175% = 1.75px，与 Windows 原生字形缩放规律一致
                // 1px logical pixel: 100% = 1px, 175% = 1.75px, consistent with Windows native glyph scaling
                height: 1px;
                background: root.foreground-color;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        // 最大化 / 还原按钮
        if WindowControls.show-maximize: maximize-btn := Rectangle {
            width: WindowControls.maximize-width;
            background: (maximize-touch.has-hover || WindowControls.max-hover) ? root.btn-hover-bg : transparent;
            animate background { duration: 100ms; }

            maximize-touch := TouchArea {
                clicked => { WindowControls.maximize(); }
            }

            // 未最大化：圆角矩形（用 Path 绘制，与还原图标同一渲染流水线）
            // Rectangle 的 border 和 Path 的 stroke 在高 DPI 下抗锯齿算法不同，
            // Path 贝塞尔曲线更接近原生字形渲染效果
            if !WindowControls.maximized: Path {
                width: 10px;
                height: 10px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                stroke: root.foreground-color;
                stroke-width: 1px;

                // 圆角矩形，圆角半径 1.5px（与还原图标前框一致）
                MoveTo { x: 1.5; y: 0; }
                LineTo { x: 8.5; y: 0; }
                QuadraticTo { control-x: 10; control-y: 0; x: 10; y: 1.5; }
                LineTo { x: 10; y: 8.5; }
                QuadraticTo { control-x: 10; control-y: 10; x: 8.5; y: 10; }
                LineTo { x: 1.5; y: 10; }
                QuadraticTo { control-x: 0; control-y: 10; x: 0; y: 8.5; }
                LineTo { x: 0; y: 1.5; }
                QuadraticTo { control-x: 0; control-y: 0; x: 1.5; y: 0; }
            }

            // 已最大化（还原）：标准 Windows 双框
            // 前框（8×8 圆角矩形）+ 后框（L 型折线，仅画顶边和右边）
            if WindowControls.maximized: Path {
                width: 10px;
                height: 10px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                stroke: root.foreground-color;
                // 1px 逻辑像素：100% = 1px，175% = 1.75px（原 1.2px = 2.1px 过粗有毛边）
                stroke-width: 1px;

                // --- 1. 前方圆角主框：(0,2)→(8,10)，圆角半径 1.5 ---
                MoveTo { x: 1.5; y: 2; }
                LineTo { x: 6.5; y: 2; }
                QuadraticTo { control-x: 8; control-y: 2; x: 8; y: 3.5; }
                LineTo { x: 8; y: 8.5; }
                QuadraticTo { control-x: 8; control-y: 10; x: 6.5; y: 10; }
                LineTo { x: 1.5; y: 10; }
                QuadraticTo { control-x: 0; control-y: 10; x: 0; y: 8.5; }
                LineTo { x: 0; y: 3.5; }
                QuadraticTo { control-x: 0; control-y: 2; x: 1.5; y: 2; }

                // --- 2. 后方 L 型折线：(2,0)→(10,0) 顶边 + (10,0)→(10,7.5) 右边 ---
                // 与前框同为 1.5px 圆角，视觉上两框完全对称
                // x: 2.5 = 左端让出半个 stroke 宽度，避免与前框左边重叠
                MoveTo { x: 2.5; y: 0; }
                LineTo { x: 8.5; y: 0; }
                QuadraticTo { control-x: 10; control-y: 0; x: 10; y: 1.5; }
                LineTo { x: 10; y: 7.5; }
            }
        }

        // 关闭按钮
        // Close button
        if WindowControls.show-close: close-btn := Rectangle {
            width: WindowControls.close-width;
            background: (close-touch.has-hover || WindowControls.close-hover) ? #c42b1c : transparent;
            animate background { duration: 100ms; }

            close-touch := TouchArea {
                clicked => { WindowControls.close(); }
            }

            Path {
                width: 10px;
                height: 10px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                stroke: (close-touch.has-hover || WindowControls.close-hover) ? #ffffff : root.foreground-color;
                stroke-width: 1px;
                animate stroke { duration: 100ms; }

                MoveTo {
                    x: 0;
                    y: 0;
                }

                LineTo {
                    x: 1;
                    y: 1;
                }

                MoveTo {
                    x: 1;
                    y: 0;
                }

                LineTo {
                    x: 0;
                    y: 1;
                }
            }
        }
    }
}
