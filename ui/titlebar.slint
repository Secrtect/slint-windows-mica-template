export global WindowControls {
    callback minimize();
    callback maximize();
    callback close();
    callback drag();
    callback double-click();

    in-out property <bool> maximized: false;

    // 暴露配置给 Rust
    in-out property <bool> show-maximize: true;
    in-out property <length> titlebar-height: 32px;
    in-out property <length> close-width: 46px;
    in-out property <length> maximize-width: 46px;

    // 新增：由 Win32 非客户区消息驱动的悬停状态
    in-out property <bool> max-hover: false;
}

export component Titlebar inherits Rectangle {
    in property <string> title: "Application";
    in property <image> icon;

    height: WindowControls.titlebar-height;
    background: transparent;

    HorizontalLayout {
        padding: 0px;
        spacing: 0px;

        drag-area := TouchArea {
            horizontal-stretch: 1;
            moved => {
                if (self.pressed) {
                    WindowControls.drag();
                }
            }

            double-clicked => {
                WindowControls.double-click();
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                spacing: 8px;
                alignment: start;

                if root.icon.width > 0 && root.icon.height > 0: Image {
                    source: root.icon;
                    width: 16px;
                    height: 16px;
                    vertical-alignment: center;
                }

                Text {
                    text: root.title;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        minimize-btn := Rectangle {
            width: 46px;
            background: minimize-touch.has-hover ? #80808030 : transparent;
            animate background { duration: 100ms; }

            minimize-touch := TouchArea {
                clicked => { WindowControls.minimize(); }
            }

            Rectangle {
                width: 10px;
                height: 1px;
                background: #cccccc;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        if WindowControls.show-maximize: maximize-btn := Rectangle {
            width: WindowControls.maximize-width;
            // 同时响应 Slint 自身 hover 与 Win32 非客户区 hover
            background: (maximize-touch.has-hover || WindowControls.max-hover) ? #80808030 : transparent;
            animate background { duration: 100ms; }

            maximize-touch := TouchArea {
                clicked => { WindowControls.maximize(); }
            }

            if !WindowControls.maximized: Rectangle {
                width: 10px;
                height: 10px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-width: 1px;
                border-color: #cccccc;
                background: transparent;
            }

            if WindowControls.maximized: Rectangle {
                width: 10px;
                height: 10px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;

                Rectangle {
                    x: 0px;
                    y: 2px;
                    width: 8px;
                    height: 8px;
                    border-width: 1px;
                    border-color: #cccccc;
                    background: transparent;
                }

                Rectangle {
                    x: 2px;
                    y: 0px;
                    width: 8px;
                    height: 1px;
                    background: #cccccc;
                }

                Rectangle {
                    x: 9px;
                    y: 0px;
                    width: 1px;
                    height: 8px;
                    background: #cccccc;
                }

                Rectangle {
                    x: 2px;
                    y: 0px;
                    width: 1px;
                    height: 2px;
                    background: #cccccc;
                }

                Rectangle {
                    x: 7px;
                    y: 7px;
                    width: 2px;
                    height: 1px;
                    background: #cccccc;
                }
            }
        }

        close-btn := Rectangle {
            width: WindowControls.close-width;
            background: close-touch.has-hover ? #c42b1c : transparent;
            animate background { duration: 100ms; }

            close-touch := TouchArea {
                clicked => { WindowControls.close(); }
            }

            Path {
                width: 10px;
                height: 10px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                stroke: close-touch.has-hover ? #ffffff : #cccccc;
                stroke-width: 1px;
                animate stroke { duration: 100ms; }

                MoveTo {
                    x: 0;
                    y: 0;
                }

                LineTo {
                    x: 1;
                    y: 1;
                }

                MoveTo {
                    x: 1;
                    y: 0;
                }

                LineTo {
                    x: 0;
                    y: 1;
                }
            }
        }
    }
}
