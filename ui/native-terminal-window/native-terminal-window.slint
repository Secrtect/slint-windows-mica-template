import { Button, ScrollView, Palette } from "std-widgets.slint";
import { TerminalTitlebar } from "./titlebar.slint";

// 原生终端窗口组件 / Native terminal window component
export component NativeTerminalWindow inherits Window {

    // 窗口尺寸与首选配置 / Window dimensions and preferred configuration
    in-out property <length> init-width: 580px;
    in-out property <length> init-height: 420px;

    preferred-width: init-width;
    preferred-height: init-height;
    min-width: 480px;
    min-height: 300px;

    // Mica 状态与背景适配 / Mica active status and background styling
    in-out property <bool> is-mica-active: false;
    background: self.is-mica-active ? transparent : Palette.background;

    // 窗口标题（保持原样供 CBT Hook 匹配）/ Window title (kept as-is for CBT Hook matching)
    title: "原生终端日志 (Console Output)";
    no-frame: false;

    // 实时终端日志数据列表 / Real-time terminal log lines
    in-out property <[string]> logs: [];

    // 回调事件 / Callback events
    callback close-requested();
    callback copy-log();
    callback drag();
    callback double-click();

    // 根卡片外壳 (带圆角剪切) / Root card container (with clipped corners)
    Rectangle {
        width: 100%;
        height: 100%;
        border-color: Palette.border;
        background: root.is-mica-active ? transparent : Palette.background;
        clip: true;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // 1. 沉浸式标题栏 (36px, 仅拖拽区，按钮由 DWM 系统原生绘制)
            // 1. Immersive titlebar (36px, drag area only; caption buttons rendered natively by DWM)
            TerminalTitlebar {
                title: root.title;
                drag => {
                    root.drag();
                }
                double-click => {
                    root.double-click();
                }
            }

            // 2. 日志容器与底部操作区域 / 2. Log container and bottom action area
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 6px;
                padding-bottom: 16px;
                spacing: 12px;
                vertical-stretch: 1;

                // 终端日志列表面板 (自动适应深浅色模式)
                // Terminal log list panel (adaptive to dark/light mode)
                log-box := Rectangle {
                    vertical-stretch: 1;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Palette.color-scheme == ColorScheme.dark ? #ffffff18 : #00000012;
                    background: Palette.color-scheme == ColorScheme.dark ? #1e1e1e : #f8f9fa;

                    ScrollView {
                        width: 100%;
                        height: 100%;

                        VerticalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 12px;
                            padding-bottom: 12px;
                            spacing: 4px;

                            for line in root.logs: Text {
                                text: line;
                                font-size: 12px;
                                font-family: "Consolas";
                                color: Palette.foreground;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // 3. 底部按钮组 (统一 36px 高度与边框模型)
                // 3. Bottom button group (unified 36px height)
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    // 复制日志按钮 (Secondary 样式 - 使用系统 Palette 调色板)
                    // Copy log button (Secondary style - uses system Palette)
                    copy-btn := Rectangle {
                        width: 130px;
                        height: 36px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Palette.border;
                        background: Palette.color-scheme == ColorScheme.dark ? #2d2d2d : #ffffff;

                        // 悬停/按压遮罩 / Hover and pressed overlay
                        Rectangle {
                            border-radius: 3px;
                            background: copy-touch.pressed
                                ? (Palette.color-scheme == ColorScheme.dark ? #ffffff15 : #00000018)
                                : (copy-touch.has-hover
                                ? (Palette.color-scheme == ColorScheme.dark ? #ffffff0d : #0000000a)
                                : transparent);
                            animate background { duration: 80ms; }
                        }

                        copy-touch := TouchArea {
                            clicked => {
                                root.copy-log();
                            }
                        }

                        Text {
                            text: "复制日志 / Copy";
                            font-size: 12px;
                            font-family: "Microsoft YaHei UI";
                            color: Palette.foreground;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // 关闭按钮 (Primary 样式 - 使用系统 Palette 调色板)
                    // Close button (Primary style - uses system Palette)
                    close-dialog-btn := Rectangle {
                        width: 96px;
                        height: 36px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: transparent;
                        background: Palette.accent-background;

                        // 悬停/按压遮罩 / Hover and pressed overlay
                        Rectangle {
                            border-radius: 3px;
                            background: close-dialog-touch.pressed
                                ? #00000033
                                : (close-dialog-touch.has-hover ? #ffffff26 : transparent);
                            animate background { duration: 80ms; }
                        }

                        close-dialog-touch := TouchArea {
                            clicked => {
                                root.close-requested();
                            }
                        }

                        Text {
                            text: "关闭 / Close";
                            font-size: 12px;
                            font-family: "Microsoft YaHei UI";
                            color: Palette.accent-foreground;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
